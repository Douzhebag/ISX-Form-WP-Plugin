# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log

# Build artifacts / packaging
*.zip

# Composer (dev-only dependencies: PHPUnit, WPCS, etc.)
/vendor/
composer.phar

# Test / lint caches (phpunit.xml.dist turns result caching off, but a
# local run with other flags or PHPUnit 10+ still writes these)
.phpunit.result.cache
.phpunit.cache/
.phpcs-cache

# Node (no build step today — guard against a stray `npm install`)
/node_modules/

# Local env / secrets
.env
.env.*

# หมายเหตุ: libs/plugin-update-checker และ assets/libs/flatpickr เป็น
# bundled vendor code ที่ deploy จริง (ไม่มี composer/npm build step)
# ต้อง commit เข้า repo — ห้าม ignore

# gettext backups / leftover merge files
*.po~
*.orig
*.rej
